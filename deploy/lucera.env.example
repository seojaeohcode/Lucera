# Copy to deploy/lucera.env for a real AI/VWorld deployment.
# The file is ignored by Git and installed on NCloud with mode 0600.
# auto uses Claude when ANTHROPIC_API_KEY is present; otherwise it uses the safe local fallback.
LUCERA_ANSWER_MODE=auto
CLAUDE_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
VWORLD_API_KEY=
VWORLD_DOMAIN=http://YOUR_SERVER_IP
ROAD_ADDRESS_API_KEY=
CLIK_API_KEY=
